{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "mauritius-dataset-flights-trigger",
  "main": "index.js",
  "compatibility_date": "2026-11-01",
  // No web address: it only runs on its schedule.
  "workers_dev": false,
  "preview_urls": false,
  // Minutes 3, 13, 23..., as the workflow's own schedule, off the round minutes.
  "triggers": { "crons": ["3-59/10 * * * *"] },
  "observability": { "enabled": true }
}
